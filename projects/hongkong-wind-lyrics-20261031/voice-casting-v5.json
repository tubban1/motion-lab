  "emotionCues": {
    "03": {
      "arc": "英文第一句：初见时的脆弱",
      "phrases": [
        {
          "text": "There was something in the air.",
          "ratePercent": -18,
          "pauseAfterMs": 640,
          "direction": "气息悬着、暗藏心动"
        }
      ]
    },
    "05": {
      "arc": "英文第二句：遗憾和无可奈何",
      "phrases": [
        {
          "text": "But my life won't let me stay.",
          "ratePercent": -23,
          "pauseAfterMs": 890,
          "direction": "不能留下：尾字自然收低"
        }
      ]
    },
    "07": {
      "arc": "粤语：分手说出口后的不舍",
      "phrases": [
        {
          "text": "明明還說分開。",
          "ratePercent": -18,
          "pauseAfterMs": 770,
          "direction": "不声嘶力竭，带哽咽般克制"
        }
      ]
    },
    "10": {
      "arc": "粤语：回想季候风与眼前的人",
      "phrases": [
        {
          "text": "那次季候風。",
          "ratePercent": -14,
          "pauseAfterMs": 760,
          "direction": "像翻到旧照片，有温度"
        },
        {
          "text": "你似季候風。",
          "ratePercent": -21,
          "pauseAfterMs": 950,
          "direction": "对你两字回望，后半句轻放"
        }
      ]
    },
    "12": {
      "arc": "粤语：余痛",
      "phrases": [
        {
          "text": "不死的心痛。",
          "ratePercent": -24,
          "pauseAfterMs": 1100,
          "direction": "轻而沉，最后不加虚假的吸气"
        }
      ]
    },
    "14": {
      "arc": "英文：无奈地面对变化",
      "phrases": [
        {
          "text": "Weathering changes.",
          "ratePercent": -19,
          "pauseAfterMs": 760,
          "direction": "缓慢接受命运的改变"
        }
      ]
    },
    "16": {
      "arc": "英文：等待与希望",
      "phrases": [
        {
          "text": "I'm waiting in Hong Kong.",
          "ratePercent": -18,
          "pauseAfterMs": 1190,
          "direction": "等待：不绝望，也不高昂"
        }
      ]
    }
  },
